    "test": "vitest run src"
  },
  "dependencies": {
    "@dispatchloop/contracts": "workspace:*",
    "@dispatchloop/policy": "workspace:*",
    "@hono/node-server": "2.1.1",
    "hono": "4.7.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "tsx": "4.20.3",
    "vitest": "4.1.11"
  }
}
