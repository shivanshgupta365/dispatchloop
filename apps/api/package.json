{
  "name": "@dispatchloop/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": { ".": { "types": "./dist/server.d.ts", "default": "./dist/server.js" } },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/dev.ts",
